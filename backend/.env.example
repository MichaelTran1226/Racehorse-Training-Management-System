# ===============================================
# EquiFlow NestJS Backend Environment Variables
# ===============================================

# Port máy chủ chạy cục bộ
PORT=3000

# Chuỗi kết nối PostgreSQL (Supabase Cloud hoặc Local PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres?sslmode=require"

# Khóa bí mật cho JWT Authentication Token
JWT_SECRET="equiflow-super-secure-production-jwt-key-2026"
JWT_EXPIRES_IN="1d"

# Cấu hình CORS
CORS_ORIGIN="http://localhost:5173"
