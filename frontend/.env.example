# ==========================================
# EquiFlow Frontend Environment Variables
# ==========================================

# Bật chế độ chạy Mock độc lập (true: dùng localStorage, false: gọi Backend NestJS thật)
VITE_USE_MOCK=true

# Địa chỉ máy chủ Backend NestJS
VITE_API_URL=http://localhost:3000/api
